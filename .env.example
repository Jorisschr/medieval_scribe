# Copy to .env for local development (npm run dev reads it automatically).
# In Docker, set these as environment variables instead.

# Admin account, created on first start. Changing ADMIN_PASSWORD later resets the password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-long-password

# The address people use to reach the app; used for invite links.
# Starting with https:// also turns on secure cookies and HSTS.
PUBLIC_URL=http://localhost:8080

# PORT=8080                # port inside the container / for npm run dev
# HOST_PORT=8080           # port on the server that docker compose binds to 127.0.0.1
# DATA_DIR=data              # where the SQLite database is stored
# SESSION_DAYS=30            # how long a login lasts
# TRUST_PROXY=false          # set to true behind a reverse proxy such as Caddy or Traefik
# LOG_REQUESTS=true
