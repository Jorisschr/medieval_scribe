# Copy to .env and fill in. Both `docker compose` and `npm run dev` read it.

# Admin account, created on first start. Changing ADMIN_PASSWORD later resets the password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-long-password

# The address people use to reach the app; used for invite links.
# Starting with https:// also turns on secure cookies and HSTS.
PUBLIC_URL=https://scribe.example.com

# --- Docker ---
# HOST_PORT=8473             # port on the server the container is published on
# BIND_ADDRESS=127.0.0.1     # 0.0.0.0 only if the tunnel/proxy runs on another machine

# --- Optional ---
# SESSION_DAYS=30            # how long a login lasts

# --- Only for npm run dev (Docker sets these itself) ---
# PORT=8080
# DATA_DIR=data              # where the SQLite database is stored
# TRUST_PROXY=false          # true behind a reverse proxy
# LOG_REQUESTS=true
